---
/**
 * Figure — an optimized image inside a rounded, bordered frame with an optional
 * caption. Hover gently zooms the image (motion-safe). Pass an imported image
 * asset (ImageMetadata) as `src`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	/** Widen slightly beyond the text column. */
	wide?: boolean;
	/** Sizes hint for responsive loading. */
	sizes?: string;
}

const { src, alt, caption, wide = false, sizes = '(min-width: 60rem) 45rem, 100vw' } =
	Astro.props;
---

<figure class:list={['fk-figure not-content fk-reveal', { 'is-wide': wide }]}>
	<div class="fk-figure__frame">
		<Image src={src} alt={alt} sizes={sizes} loading="lazy" />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
