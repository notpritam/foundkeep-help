---
/**
 * Your library <-> Claude / Codex over MCP.
 * Shows the agent reading and searching the library and helping organize it,
 * with the deliberate limit: agents can't delete. Flat, on-brand SVG.
 */
interface Props {
	caption?: string;
	animated?: boolean;
}
const {
	caption = 'Connected over MCP, an agent can read, search, create and organize — but it can never delete.',
	animated = true,
} = Astro.props;
const flowClass = animated ? 'fk-d-flow fk-d-flow--animated' : 'fk-d-flow';
---

<figure class="fk-diagram not-content fk-reveal">
	<svg viewBox="0 0 760 300" role="img" aria-label="Your library connects to Claude or Codex over MCP; the agent can read, search, create and organize your saves, but cannot delete them">
		<defs>
			<marker id="fk-mcp-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="fk-d-accent-fill" />
			</marker>
		</defs>

		<!-- Left: your library -->
		<rect x="30" y="70" width="210" height="170" rx="18" class="fk-d-node" />
		<g class="fk-d-accent" stroke-linejoin="round">
			<rect x="98" y="108" width="74" height="20" rx="5" />
			<rect x="98" y="134" width="74" height="20" rx="5" />
			<rect x="98" y="160" width="74" height="20" rx="5" />
		</g>
		<text x="135" y="212" text-anchor="middle" class="fk-d-title" font-size="18">Your library</text>
		<text x="135" y="231" text-anchor="middle" class="fk-d-label" font-size="12">private saves</text>

		<!-- Right: Claude / Codex -->
		<rect x="520" y="70" width="210" height="170" rx="18" class="fk-d-node" />
		<path
			d="M625 104 v40 M605 124 h40 M611 110 l28 28 M639 110 l-28 28"
			class="fk-d-accent"
			stroke-linecap="round"
		/>
		<text x="625" y="212" text-anchor="middle" class="fk-d-title" font-size="18">Claude · Codex</text>
		<text x="625" y="231" text-anchor="middle" class="fk-d-label" font-size="12">your AI assistant</text>

		<!-- MCP channel label -->
		<rect x="330" y="70" width="100" height="34" rx="17" class="fk-d-node" />
		<text x="380" y="92" text-anchor="middle" class="fk-d-title" font-size="15">MCP</text>
		<text x="380" y="122" text-anchor="middle" class="fk-d-label" font-size="11">browser sign-in · no token</text>

		<!-- read / search : library -> agent -->
		<text x="380" y="150" text-anchor="middle" class="fk-d-label" font-size="13">read · search</text>
		<path d="M248 163 H512" class={flowClass} marker-end="url(#fk-mcp-arrow)" />

		<!-- create / organize : agent -> library -->
		<path d="M512 196 H248" class={flowClass} marker-end="url(#fk-mcp-arrow)" />
		<text x="380" y="221" text-anchor="middle" class="fk-d-label" font-size="13">create · organize · link</text>

		<!-- can't delete -->
		<g transform="translate(300 250)">
			<rect x="0" y="0" width="160" height="34" rx="17" class="fk-d-node" />
			<circle cx="22" cy="17" r="9" fill="none" stroke="var(--sl-color-gray-3)" stroke-width="1.6" />
			<path d="M15 24 L29 10" stroke="var(--sl-color-gray-3)" stroke-width="1.6" stroke-linecap="round" />
			<text x="42" y="22" class="fk-d-label" font-size="13">can't delete</text>
		</g>
	</svg>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
